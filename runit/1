#!/bin/dash

# 1. Silence everything by default
exec > /dev/null 2>&1

# 2. Define the Systemd-style status printer
status() {
    printf "  [\033[1;32m  OK  \033[0m] %-30s\n" "$1"
}

# 3. Direct output to console for the sequence we want to see
exec > /dev/console 2>&1

# --- CORE FILE SYSTEM STABILISATION ---

# Establish pristine volatile runtime filesystems
# Note: /proc, /sys, and /dev were already cleanly moved into place by our initramfs!
mkdir -p /run /var/run /var/lock /var/log /tmp
chmod 755 /run /var/run
chmod 1777 /tmp
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
status "Mounting runtime filesystems"

# Processes your real root partition's /etc/fstab safely (Mounts /boot, etc.)
# Handled cleanly via your uutils 'mount' binary engine
mount -a
status "Mounting target storage volumes"


# --- HARDWARE INITIALISATION & GRAPHICS MODULE LOADING ---

# Trigger native PCI bus scanning to detect your Ryzen 7 hardware pathways
echo add > /sys/bus/pci/drivers_probe
status "Initializing PCI hardware lanes"


# --- TERMINAL CONSOLE CONFIGURATION ---

# Process regional preferences if a configuration file exists
if [ -f /etc/vconsole.conf ]; then
    . /etc/vconsole.conf
    # We check for kbd utilities before running to prevent noisy shell crashes
    if command -v loadkeys >/dev/null 2>&1; then
        [ -n "$KEYMAP" ] && loadkeys "$KEYMAP" >/dev/null 2>&1
        [ -n "$FONT" ] && setfont "$FONT" >/dev/null 2>&1
        status "Setting console text preferences"
    fi
fi


# --- FINAL STAGE HANDOFF ---

# Create runit's internal indicator block to signal successful completion of Stage 1
touch /etc/runit/stopit
chmod 0 /etc/runit/stopit

