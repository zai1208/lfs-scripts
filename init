#!/bin/busybox sh

# Define the status function for your "Systemd" look
status() {
    printf "  [\033[1;32m  OK  ]\033[0m] %-30s\n" "$1"
}

# 1. Quiet virtual filesystem initialization
mount -t proc proc /proc >/dev/null 2>&1
mount -t sysfs sysfs /sys >/dev/null 2>&1
mount -t devtmpfs dev /dev >/dev/null 2>&1

# 2. Re-establish console control
exec </dev/console >/dev/console 2>/dev/console

# 3. Clear the screen once here to prepare for the "Linear Boot"
clear

# 4. Decryption Phase
echo "Enter passphrase to unlock root:"
# FIX: Adjusted binary path to target your custom standalone /sbin/cryptsetup location
/sbin/cryptsetup luksOpen /dev/nvme0n1p7 kore_root --key-slot 0 --disable-keyring >/dev/null 2>&1
status "Decrypting Root (kore_root)"

# Note: "Attempting to load amdgpu" block is completely removed here! 
# Since amdgpu=y, your Ryzen 7 graphics engine is already fully operational.

# FIX: Create and mount to /mnt/kore to seamlessly match standard LFS target naming structures
mkdir -p /mnt/kore
mount -t ext4 /dev/mapper/kore_root /mnt/kore >/dev/null 2>&1
status "Mounting Root Filesystem"

# 5. Move live mount points safely into your new partition space
mount --move /proc /mnt/kore/proc
mount --move /sys /mnt/kore/sys
mount --move /dev /mnt/kore/dev

# 6. Final Handoff
# FIX: Swapped handover endpoint path to /mnt/kore, passing execution directly 
# to your newly mapped /sbin/init symlink target!
exec switch_root /mnt/kore /sbin/init

